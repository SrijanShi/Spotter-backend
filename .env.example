# Copy to .env and edit. Every value here is optional: with no .env at all the
# project runs against the keyless public OSRM routing server.

# --- Routing ---------------------------------------------------------------
# OpenRouteService API key (free: https://openrouteservice.org/dev/#/signup).
# When set it becomes the primary router - it is faster than the public OSRM
# demo server. OSRM stays as the automatic fallback.
ORS_API_KEY=
ORS_PROFILE=driving-car

# Self-hosted OSRM, if you have one.
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT=20

# Nominatim asks that clients identify themselves; put your contact here.
GEOCODER_USER_AGENT=spotter-fuel-route-planner/1.0 (you@example.com)

# --- Django ----------------------------------------------------------------
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-insecure-key-change-in-production
DJANGO_ALLOWED_HOSTS=*
