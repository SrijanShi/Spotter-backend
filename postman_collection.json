    {
      "name": "7. Error: no station can bridge the range (422)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/v1/route/?start=Los Angeles, CA&finish=Seattle, WA",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "Los Angeles, CA"
            },
            {
              "key": "finish",
              "value": "Seattle, WA"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"422 with the gap explained\", () => {",
              "  pm.response.to.have.status(422);",
              "  const b = pm.response.json();",
              "  pm.expect(b.error).to.eql(\"route_not_fuelable\");",
              "  pm.expect(b.gap_miles).to.be.above(500);",
              "});"
            ]
          }
        }
      ]
    },
