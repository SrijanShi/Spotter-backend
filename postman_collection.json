        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"finish\": \"Denver, CO\",\n  \"mpg\": 6.5,\n  \"range_miles\": 400,\n  \"max_detour_miles\": 20\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/route/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "route",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test(\"returns a map of the route\", () => pm.expect(b.map_url).to.include(\"/map/\"));",
              "pm.test(\"every mile is paid for: gallons = miles / mpg\", () =>",
