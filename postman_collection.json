{
  "info": {
    "name": "Fuel-Optimal Route API",
    "description": "Plans a US route and the cheapest practical way to fuel it (500 mile range, 10 mpg).\n\nRun the requests top to bottom, or use Run collection. Each has tests - open the Test Results tab. Request 1 is forced cold; request 2 is the same route from cache with zero external API calls; request 3 shows the cheapest-fuel-only plan for comparison. Every successful response includes map_url: open it to see the route and fuel stops on a map.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "default_cost",
      "value": ""
    },
    {
      "key": "default_stops",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Dallas -> New York (place names)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/v1/route/?start=Dallas, TX&finish=New York, NY&refresh=true",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "Dallas, TX"
            },
            {
              "key": "finish",
              "value": "New York, NY"
            },
            {
              "key": "refresh",
              "value": "true"
            }
          ]
        },
        "description": "refresh=true skips the cache so this is a genuinely cold plan."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test(\"returns a map of the route\", () => pm.expect(b.map_url).to.include(\"/map/\"));",
              "pm.test(\"every mile is paid for: gallons = miles / mpg\", () =>",
              "  pm.expect(b.totals.gallons).to.be.closeTo(b.route.distance_miles / b.vehicle.mpg, 0.5));",
              "pm.test(\"totals are the exact sum of the stops\", () => {",
              "  const sum = b.fuel_stops.reduce((t, s) => t + s.cost, 0);",
              "  pm.expect(b.totals.fuel_cost).to.be.closeTo(sum, 0.005);",
              "});",
              "pm.test(\"no two stops further apart than the range\", () => {",
              "  const m = b.fuel_stops.map(s => s.mile_marker);",
              "  for (let i = 1; i < m.length; i++) pm.expect(m[i] - m[i-1]).to.be.at.most(b.vehicle.range_miles);",
              "});",
              "pm.test(\"at most 3 external API calls\", () => pm.expect(b.meta.external_api_calls).to.be.at.most(3));",
              "console.log(`${b.route.distance_miles} mi, ${b.totals.stops} stops, $${b.totals.fuel_cost} ` +",
              "  `(cheapest-fuel-only plan: ${b.optimization.cheapest_fuel_only_plan ? b.optimization.cheapest_fuel_only_plan.stops + \" stops, $\" + b.optimization.cheapest_fuel_only_plan.fuel_cost : \"n/a\"}), ` +",
              "  `${b.meta.external_api_calls} external call(s), ${b.meta.compute_ms} ms`);",
              "pm.test(\"place names resolved offline: exactly 1 external call (the route)\", () =>",
              "  pm.expect(b.meta.external_api_calls).to.eql(1));",
              "pm.test(\"fewer stops than the cheapest-fuel-only plan would make\", () =>",
              "  pm.expect(b.totals.stops).to.be.at.most(b.optimization.cheapest_fuel_only_plan.stops));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Same route again (served from cache)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/v1/route/?start=Dallas, TX&finish=New York, NY",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "Dallas, TX"
            },
            {
              "key": "finish",
              "value": "New York, NY"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test(\"returns a map of the route\", () => pm.expect(b.map_url).to.include(\"/map/\"));",
              "pm.test(\"every mile is paid for: gallons = miles / mpg\", () =>",
              "  pm.expect(b.totals.gallons).to.be.closeTo(b.route.distance_miles / b.vehicle.mpg, 0.5));",
              "pm.test(\"totals are the exact sum of the stops\", () => {",
              "  const sum = b.fuel_stops.reduce((t, s) => t + s.cost, 0);",
              "  pm.expect(b.totals.fuel_cost).to.be.closeTo(sum, 0.005);",
              "});",
              "pm.test(\"no two stops further apart than the range\", () => {",
              "  const m = b.fuel_stops.map(s => s.mile_marker);",
              "  for (let i = 1; i < m.length; i++) pm.expect(m[i] - m[i-1]).to.be.at.most(b.vehicle.range_miles);",
              "});",
              "pm.test(\"at most 3 external API calls\", () => pm.expect(b.meta.external_api_calls).to.be.at.most(3));",
              "console.log(`${b.route.distance_miles} mi, ${b.totals.stops} stops, $${b.totals.fuel_cost} ` +",
              "  `(cheapest-fuel-only plan: ${b.optimization.cheapest_fuel_only_plan ? b.optimization.cheapest_fuel_only_plan.stops + \" stops, $\" + b.optimization.cheapest_fuel_only_plan.fuel_cost : \"n/a\"}), ` +",
              "  `${b.meta.external_api_calls} external call(s), ${b.meta.compute_ms} ms`);",
              "pm.test(\"served from cache\", () => pm.expect(b.meta.cached).to.be.true);",
              "pm.test(\"zero external API calls\", () => pm.expect(b.meta.external_api_calls).to.eql(0));",
              "pm.collectionVariables.set(\"default_cost\", b.totals.fuel_cost);",
              "pm.collectionVariables.set(\"default_stops\", b.totals.stops);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Same route, no charge for driver time (stop_penalty=0)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/v1/route/?start=Dallas, TX&finish=New York, NY&stop_penalty=0",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "Dallas, TX"
            },
            {
              "key": "finish",
              "value": "New York, NY"
            },
            {
              "key": "stop_penalty",
              "value": "0"
            }
          ]
        },
        "description": "stop_penalty=0 removes the $5 time cost per stop (detour fuel still counts), so the plan buys cheaper fuel over more stops. Compare with request 2."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test(\"returns a map of the route\", () => pm.expect(b.map_url).to.include(\"/map/\"));",
              "pm.test(\"every mile is paid for: gallons = miles / mpg\", () =>",
              "  pm.expect(b.totals.gallons).to.be.closeTo(b.route.distance_miles / b.vehicle.mpg, 0.5));",
              "pm.test(\"totals are the exact sum of the stops\", () => {",
              "  const sum = b.fuel_stops.reduce((t, s) => t + s.cost, 0);",
              "  pm.expect(b.totals.fuel_cost).to.be.closeTo(sum, 0.005);",
              "});",
              "pm.test(\"no two stops further apart than the range\", () => {",
              "  const m = b.fuel_stops.map(s => s.mile_marker);",
              "  for (let i = 1; i < m.length; i++) pm.expect(m[i] - m[i-1]).to.be.at.most(b.vehicle.range_miles);",
              "});",
              "pm.test(\"at most 3 external API calls\", () => pm.expect(b.meta.external_api_calls).to.be.at.most(3));",
              "console.log(`${b.route.distance_miles} mi, ${b.totals.stops} stops, $${b.totals.fuel_cost} ` +",
              "  `(cheapest-fuel-only plan: ${b.optimization.cheapest_fuel_only_plan ? b.optimization.cheapest_fuel_only_plan.stops + \" stops, $\" + b.optimization.cheapest_fuel_only_plan.fuel_cost : \"n/a\"}), ` +",
              "  `${b.meta.external_api_calls} external call(s), ${b.meta.compute_ms} ms`);",
              "const cost = Number(pm.collectionVariables.get(\"default_cost\"));",
              "const stops = Number(pm.collectionVariables.get(\"default_stops\"));",
              "pm.test(\"cheaper fuel than the default plan...\", () => pm.expect(b.totals.fuel_cost).to.be.at.most(cost));",
              "pm.test(\"...by making more stops\", () => pm.expect(b.totals.stops).to.be.at.least(stops));"
            ]
          }
        }
      ]
    },
